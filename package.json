{
  "name": "olvr-one",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "assets:build": "node scripts/build-images.mjs",
    "lint": "eslint . --max-warnings=0",
    "audit:check": "node scripts/check-audit.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "prebuild": "npm run assets:build",
    "build": "next build",
    "smoke": "node scripts/check-export.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "profile": "node scripts/profile.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "gsap": "3.15.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "wrangler": "4.149.0"
  }
}
